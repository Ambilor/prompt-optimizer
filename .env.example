# Model configuration
MODEL=gpt-3.5-turbo
# OPTIONS: gpt-3.5-turbo, gpt-4, claude-3, gemini-pro

# Optimization settings
AGGRESSIVENESS=medium
# OPTIONS: low, medium, high

# Language
LANGUAGE=es
# OPTIONS: es, en

# Preserve keywords
PRESERVE_KEYWORDS=true

# Remove explanations in aggressive mode
REMOVE_EXPLANATIONS=false

# Cost calculation
ENABLE_COST_ESTIMATION=true
